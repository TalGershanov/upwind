.DS_Store
.idea/
.venv/
__pycache__/
.pytest_cache/
logs/

# Terraform: local state and plugins must never be committed
# (.terraform.lock.hcl SHOULD be committed — it pins provider versions)
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfvars
*.tfplan
crash.log

# Terraform: generated app zip (rebuilt on every plan)
terraform/build/
tests/
tests/
